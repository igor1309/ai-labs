                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "iLVhz3",
                          "name": "Answer · scrolls inside the sheet",
                          "clip": true,
                          "width": "fill_container",
                          "height": "fill_container",
                          "layout": "vertical",
                          "children": [
                            {
                              "type": "text",
                              "id": "P3E7O7",
                              "name": "Answer text",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Если совсем просто: в этом абзаце перечислены ловушки, в которые психолог попадает не из-за клиента, а из-за самого себя. Власть — это соблазн решать за клиента, как ему жить, ведь он пришёл за помощью и доверяет. Самокрасование — желание выглядеть умным и успешным, когда впечатление становится важнее пользы. Ответственность — вопрос о том, где кончается работа психолога и начинается выбор самого клиента. Близкие отношения с клиентом опасны тем, что смешивают помощь и личную жизнь, и тогда страдает и то и другое. Недостаточная зрелость и слабая подготовка означают, что психолог берётся за то, к чему пока не готов. Личностная проработанность — это то, насколько психолог разобрался со своими трудностями, чтобы не переносить их на клиента. Разочарование в профессии и работоголизм — две стороны выгорания: один перестаёт верить в смысл работы, другой не может от неё оторваться.\n\nОбщая мысль такая: прежде чем помогать другому, психологу нужно честно видеть свои слабые места. Иначе они незаметно становятся частью его работы с людьми, и клиент получает не помощь, а продолжение чужих проблем. Поэтому психологу так важны собственная терапия и супервизия: они помогают вовремя замечать эти ловушки.",
                              "lineHeight": 1.6,
                              "fontFamily": "$font-sans",
                              "fontSize": "$text-md",
                              "fontWeight": "normal"
                            }
                          ]
                        }
