                            }
                          ]
                        },
                        {
                          "type": "text",
                          "id": "qXxBl",
                          "name": "Runs workflow",
                          "fill": "$text-body",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "another workflow, as a child run: its inputs resolve when it starts, over the params the item binds, in its own boundary; its steps are called as <item>/<step>, with the pass where the item is in a repeat",
                          "lineHeight": 1.55,
                          "fontFamily": "$sans",
                          "fontSize": 15,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "w0T45",
                          "name": "Out workflow",
                          "fill": "$text-sub",
                          "textGrowth": "fixed-width",
                          "width": 250,
                          "content": "its outputs; one output named output is given whole",
                          "lineHeight": 1.55,
                          "fontFamily": "$sans",
                          "fontSize": 15,
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "id": "ZfBLd",
                      "name": "P where items sit",
                      "fill": "$text-body",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Items sit anywhere an item may: in the workflow's steps, an arm, a repeat's body; a parallel holds steps and workflows. A condition is pure: it reads params, inputs, a repeat's state and the outputs of items already ended, with equals, present, all, any, and, or and not. A number never equals a string, and params and inputs are strings.",
                      "lineHeight": 1.65,
                      "fontFamily": "$sans",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "frame",
                      "id": "H5Zi1z",
                      "name": "Naming",
                      "width": "fill_container",
                      "gap": 16,
                      "children": [
                        {
                          "type": "frame",
                          "id": "X8H4z",
                          "name": "Name fix/2/1",
                          "width": "fill_container",
                          "fill": "$surface",
                          "cornerRadius": 6,
                          "stroke": "$line-soft",
                          "strokeWidth": 1,
                          "layout": "vertical",
                          "gap": 10,
                          "padding": 16,
                          "children": [
                            {
                              "type": "text",
                              "id": "ZPdlt",
                              "name": "Example fix/2/1",
                              "fill": "$text",
                              "content": "fix/2/1",
                              "fontFamily": "$mono",
                              "fontSize": 15,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "FpexN",
                              "name": "Text fix/2/1",
                              "fill": "$text-sub",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "A step in a repeat is named by its pass, outer passes first where repeats nest. The call, its record entry, its progress line, its events and reuse all use that name; its plan is found by the name it is declared by.",
                              "lineHeight": 1.55,
                              "fontFamily": "$sans",
                              "fontSize": 14,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "M4aQq",
                          "name": "Name tests/revise/1",
                          "width": "fill_container",
                          "fill": "$surface",
                          "cornerRadius": 6,
                          "stroke": "$line-soft",
                          "strokeWidth": 1,
                          "layout": "vertical",
                          "gap": 10,
                          "padding": 16,
                          "children": [
                            {
                              "type": "text",
                              "id": "NFYOL",
                              "name": "Example tests/revise/1",
                              "fill": "$text",
                              "content": "tests/revise/1",
                              "fontFamily": "$mono",
                              "fontSize": 15,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "D3Yzbj",
                              "name": "Text tests/revise/1",
                              "fill": "$text-sub",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "A step inside a workflow item is named under the item. The child's steps are planned as <item>/<step> before anything runs.",
                              "lineHeight": 1.55,
                              "fontFamily": "$sans",
                              "fontSize": 14,
                              "fontWeight": "normal"
                            }
                          ]
                        }
                      ]
