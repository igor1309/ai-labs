                    },
                    {
                      "type": "frame",
                      "id": "xOaZJ",
                      "name": "its body, then binds next over its state",
                      "context": "td",
                      "width": 385.24,
                      "height": 107.19,
                      "stroke": "#232327",
                      "strokeWidth": {
                        "bottom": 1
                      },
                      "strokeAlignment": "inner",
                      "layout": "vertical",
                      "padding": [
                        6,
                        8
                      ],
                      "justifyContent": "center",
                      "children": [
                        {
                          "type": "text",
                          "id": "i8aQE",
                          "fill": "#d9d9df",
                          "textGrowth": "fixed-width",
                          "width": 369.24,
                          "content": "its body, then binds next over its state, then reads until; again until it holds or max passes have run; never reads until before the first pass",
                          "lineHeight": 1.6,
                          "fontFamily": "Helvetica Neue",
                          "fontSize": 14.72,
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "sayvz",
