                {
                  "type": "text",
                  "id": "DjzUN",
                  "name": "An arrow is a call through a port; the c",
                  "context": "figcaption",
                  "fill": "#8a8a96",
                  "textGrowth": "fixed-width-height",
                  "width": "fill_container",
                  "height": 65.27,
                  "content": "An arrow is a call through a port; the composition, in cmd/agister, wires every one. Core knows no settings file, no git and no runtime: it is given a workflow of items and a caller, and tells what happens to an events port.",
                  "lineHeight": 1.6,
                  "fontFamily": "Helvetica Neue",
                  "fontSize": 13.6,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
