                      "strokeWidth": {
                        "bottom": 1
                      },
                      "strokeAlignment": "inner",
                      "layout": "vertical",
                      "padding": [
                        6,
                        8
                      ],
                      "justifyContent": "center",
                      "children": [
                        {
                          "type": "text",
                          "id": "pK5MS",
                          "fill": "#d9d9df",
                          "textGrowth": "fixed-width",
                          "width": 194.16,
                          "content": "{\"state\", \"stopped\", \"passes\"}: the last state, until or max, and how many passes ran",
                          "lineHeight": 1.6,
                          "fontFamily": "Helvetica Neue",
                          "fontSize": 14.72,
                          "fontWeight": "normal"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "frame",
