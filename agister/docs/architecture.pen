                    {
                      "type": "frame",
                      "id": "WA8HL",
                      "name": "the request, status and result; every ca",
                      "context": "td",
                      "width": 551.2,
                      "height": 130.73,
                      "stroke": "#232327",
                      "strokeWidth": {
                        "bottom": 1
                      },
                      "strokeAlignment": "inner",
