                          "content": "workflow",
                          "lineHeight": 1.6,
                          "fontFamily": "Helvetica Neue",
                          "fontSize": 14.72,
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "QDArX",
                      "name": "another workflow, as a child run: its in",
                      "context": "td",
                      "width": 385.24,
                      "height": 130.73,
                      "stroke": "#232327",
                      "strokeWidth": {
                        "bottom": 1
                      },
                      "strokeAlignment": "inner",
                      "layout": "vertical",
                      "padding": [
                        6,
                        8
                      ],
                      "justifyContent": "center",
                      "children": [
                        {
                          "type": "text",
                          "id": "C2gsN6",
                          "fill": "#d9d9df",
                          "textGrowth": "fixed-width",
                          "width": 369.24,
                          "content": "another workflow, as a child run: its inputs resolve when it starts, over the params the item binds, in its own boundary; its steps are called as <item>/<step>, with the pass where the item is in a repeat",
                          "lineHeight": 1.6,
                          "fontFamily": "Helvetica Neue",
                          "fontSize": 14.72,
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "CxNlk",
                      "name": "its outputs; one output named output is ",
                      "context": "td",
                      "width": 210.16,
                      "height": 130.73,
                      "stroke": "#232327",
                      "strokeWidth": {
                        "bottom": 1
                      },
                      "strokeAlignment": "inner",
                      "layout": "vertical",
                      "padding": [
                        6,
                        8
                      ],
                      "justifyContent": "center",
                      "children": [
                        {
                          "type": "text",
                          "id": "CLBVP",
                          "fill": "#d9d9df",
                          "textGrowth": "fixed-width",
                          "width": 194.16,
                          "content": "its outputs; one output named output is given whole",
                          "lineHeight": 1.6,
                          "fontFamily": "Helvetica Neue",
                          "fontSize": 14.72,
                          "fontWeight": "normal"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "frame",
              "id": "oerYO",
              "name": "spacer",
              "width": "fill_container",
              "height": 16.49,
              "layout": "none"
            },
            {
              "type": "text",
              "id": "eXwB6",
              "name": "Items sit anywhere an item may: in the w",
              "context": "p",
              "fill": "#d9d9df",
              "textGrowth": "fixed-width-height",
              "width": "fill_container",
              "height": 153.56,
              "content": "Items sit anywhere an item may: in the workflow's steps, an arm, a repeat's body; a parallel holds steps and workflows. A condition is pure: it reads params, inputs, a repeat's state and the outputs of items already ended, with equals, present, all, any, and, or and not. A number never equals a string, and params and inputs are strings. A repeat's body sees the state of the repeats around it, its own over theirs; a name next does not bind keeps its value.",
              "lineHeight": 1.6,
              "fontFamily": "Helvetica Neue",
              "fontSize": 16,
              "fontWeight": "normal"
            },
            {
              "type": "frame",
              "id": "RnC35",
              "name": "spacer",
              "width": "fill_container",
              "height": 12.01,
              "layout": "none"
            },
            {
              "type": "text",
              "id": "HYH0R",
              "name": "A step in a repeat is named by its pass,",
              "context": "p",
              "fill": "#d9d9df",
              "textGrowth": "fixed-width-height",
              "width": "fill_container",
              "height": 76.78,
              "content": "A step in a repeat is named by its pass, <step>/<pass>, outer passes first where repeats nest (fix/2/1); the call, its record entry, its progress line, its events and reuse all use that name, and its plan is found by the name it is declared by.",
              "lineHeight": 1.6,
              "fontFamily": "Helvetica Neue",
              "fontSize": 16,
              "fontWeight": "normal"
            },
            {
              "type": "frame",
              "id": "PtnAK",
              "name": "spacer",
              "width": "fill_container",
              "height": 36,
              "layout": "none"
            },
            {
              "type": "text",
              "id": "gdvAu",
              "name": "A call",
              "context": "h2",
              "fill": "#d9d9df",
              "content": "A call",
              "lineHeight": 1.25,
              "fontFamily": "Iowan Old Style",
              "fontSize": 24,
              "fontWeight": "normal"
            },
            {
              "type": "frame",
              "id": "Y4hAJM",
              "name": "spacer",
              "width": "fill_container",
              "height": 8,
              "layout": "none"
            },
            {
              "type": "text",
              "id": "HspRv",
              "name": "A call is one step executed. core/admit ",
              "context": "p",
              "fill": "#d9d9df",
              "textGrowth": "fixed-width-height",
              "width": "fill_container",
              "height": 127.97,
              "content": "A call is one step executed. core/admit holds its worktree first, as a reader or a writer, checks a pinned revision and a clean worktree where the process asks, and keeps the call to its limits and the day's budget. core/call then makes turns on the runtime through its wrapper and the supervisor, which starts the program, keeps the ends of its output and ends its whole group:",
              "lineHeight": 1.6,
              "fontFamily": "Helvetica Neue",
              "fontSize": 16,
              "fontWeight": "normal"
            },
            {
              "type": "frame",
              "id": "SRhrh",
              "name": "spacer",
              "width": "fill_container",
              "height": 16,
              "layout": "none"
            },
            {
              "type": "frame",
              "id": "xv79T",
              "name": "ul",
              "context": "ul",
              "width": "fill_container",
              "layout": "vertical",
              "padding": [
                0,
                0,
                0,
                40
              ],
              "children": [
                {
                  "type": "text",
                  "id": "HCRjy",
                  "name": "a turn at capacity is made again, after ",
                  "context": "li",
                  "fill": "#d9d9df",
                  "textGrowth": "fixed-width-height",
                  "width": "fill_container",
                  "height": 51.19,
                  "content": "a turn at capacity is made again, after 30 s, 1, 3 and 5 minutes, each telling the session to go on; then the call starts fresh on its agent's fallback, if it names one;",
                  "lineHeight": 1.6,
                  "fontFamily": "Helvetica Neue",
                  "fontSize": 16,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "j1329",
                  "name": "a turn that goes stale is followed by a ",
                  "context": "li",
                  "fill": "#d9d9df",
                  "textGrowth": "fixed-width-height",
                  "width": "fill_container",
                  "height": 51.19,
                  "content": "a turn that goes stale is followed by a recovery turn in its session, where the process allows a resume;",
                  "lineHeight": 1.6,
                  "fontFamily": "Helvetica Neue",
                  "fontSize": 16,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "AwcDW",
                  "name": "a call may continue an earlier step's se",
                  "context": "li",
                  "fill": "#d9d9df",
                  "textGrowth": "fixed-width-height",
                  "width": "fill_container",
                  "height": 51.19,
                  "content": "a call may continue an earlier step's session, by a binding; it goes on from where that session's latest call left the worktree;",
                  "lineHeight": 1.6,
                  "fontFamily": "Helvetica Neue",
                  "fontSize": 16,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "N8sPbd",
                  "name": "each turn counts its own cost, claude-co",
                  "context": "li",
                  "fill": "#d9d9df",
                  "textGrowth": "fixed-width-height",
                  "width": "fill_container",
                  "height": 51.19,
                  "content": "each turn counts its own cost, claude-code's as reported, codex's priced through ccusage, against the process's limit and the daily budget.",
                  "lineHeight": 1.6,
                  "fontFamily": "Helvetica Neue",
                  "fontSize": 16,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "M2VAwf",
              "name": "spacer",
              "width": "fill_container",
              "height": 16,
              "layout": "none"
            },
            {
              "type": "text",
              "id": "Vltir",
              "name": "At its end a call keeps the HEAD and con",
              "context": "p",
              "fill": "#d9d9df",
              "textGrowth": "fixed-width-height",
              "width": "fill_container",
              "height": 51.19,
              "content": "At its end a call keeps the HEAD and content it left, and, where it pinned a revision, its changes as a patch.",
              "lineHeight": 1.6,
              "fontFamily": "Helvetica Neue",
              "fontSize": 16,
              "fontWeight": "normal"
            },
            {
              "type": "frame",
              "id": "oRMWp",
              "name": "spacer",
              "width": "fill_container",
              "height": 35.99,
              "layout": "none"
            },
            {
              "type": "text",
              "id": "D4mN60",
              "name": "What a run leaves",
              "context": "h2",
              "fill": "#d9d9df",
              "content": "What a run leaves",
              "lineHeight": 1.25,
              "fontFamily": "Iowan Old Style",
              "fontSize": 24,
              "fontWeight": "normal"
            },
            {
              "type": "frame",
              "id": "u1QI6",
              "name": "spacer",
              "width": "fill_container",
              "height": 8,
              "layout": "none"
            },
            {
              "type": "text",
              "id": "CQdVT",
              "name": "Each run is a folder under ~/.agister/ru",
              "context": "p",
              "fill": "#d9d9df",
              "textGrowth": "fixed-width-height",
              "width": "fill_container",
              "height": 51.19,
              "content": "Each run is a folder under ~/.agister/runs, named by its id, its start's UTC time and six random hex characters:",
              "lineHeight": 1.6,
              "fontFamily": "Helvetica Neue",
              "fontSize": 16,
              "fontWeight": "normal"
            },
            {
              "type": "frame",
              "id": "pIAjc",
              "name": "spacer",
              "width": "fill_container",
              "height": 12,
              "layout": "none"
            },
