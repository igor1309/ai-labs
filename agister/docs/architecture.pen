                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "agister check shares that list, so it refuses exactly what a run would.",
                          "lineHeight": 1.65,
                          "fontFamily": "$sans",
                          "fontSize": 16,
                          "fontWeight": "normal"
                        }
                      ]
