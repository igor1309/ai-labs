                      "children": [
                        {
                          "type": "text",
                          "id": "Jhd7a",
                          "fill": "#d9d9df",
                          "textGrowth": "fixed-width",
                          "width": 535.2,
                          "content": "the request, status and result; every call ended, as <run id>/<step>, with its process, agent, inputs, permission plan, environment, definition files by digest, HEAD and content, cost and result; under children, each child run, as <run id>/<item>, with its workflow, params, inputs and their identities, status and output; written whole as each call ends, lost until the run ends",
                          "lineHeight": 1.6,
                          "fontFamily": "Helvetica Neue",
                          "fontSize": 14.72,
                          "fontWeight": "normal"
                        }
                      ]
                    }
