{
  "name": "agister",
  "version": "0.0.1",
  "private": true,
  "description": "Agister CLI: provider runtime adapters and agent-backed processes, run locally without a service.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "agister": "node --disable-warning=ExperimentalWarning --import tsx src/main.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit -p ."
  }
}
