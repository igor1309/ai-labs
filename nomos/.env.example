# Nomos configuration
NOMOS_PORT=8080
NOMOS_HOST=0.0.0.0
NOMOS_DB_PATH=data/nomos.db
NODE_ENV=production

# Vendor (upstream AI provider)
NOMOS_VENDOR_BASE_URL=https://api.openai.com/v1
NOMOS_VENDOR_TIMEOUT_MS=30000
NOMOS_VENDOR_API_KEY=sk-your-key-here
NOMOS_JSON_BODY_LIMIT=1mb

# Stub API (disable in production)
NOMOS_STUB_ENABLED=false
NOMOS_FIXTURES_DIR=tests/fixtures

# Safeguards (prompt injection detection & sanitization)
NOMOS_SAFEGUARDS_ENABLED=true
NOMOS_SAFEGUARDS_SANITIZE=true
NOMOS_SAFEGUARDS_REINFORCE=false
NOMOS_SAFEGUARDS_BLOCK=false
NOMOS_SAFEGUARDS_REINFORCE_PREPEND=
NOMOS_SAFEGUARDS_REINFORCE_APPEND=
