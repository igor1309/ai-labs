    {
      "type": "text",
      "id": "amCjx",
      "x": 3224,
      "y": 37880,
      "name": "Storyboard Note 2",
      "fill": "$fm-ink",
      "textGrowth": "fixed-width",
      "width": 1440,
      "content": "2 · BRUSHING\nCrumbly edges, a lip of grains, the sand's shadow in the hollow. When a telling part first shows (an eye, a horn, a frill), it shines once with a ring and a star pop. The picture itself is the progress; nothing else on screen.",
      "lineHeight": 1.45,
      "fontFamily": "Lexend",
      "fontSize": 24,
      "fontWeight": "normal"
    },
