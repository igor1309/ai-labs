        {
          "type": "text",
          "id": "z3Bo9",
          "name": "Rule · One creature per game",
          "fill": "$ds-ink",
          "textGrowth": "fixed-width",
          "width": 960,
          "content": "Each Home game owns one different creature in every theme, locale and device. A skeleton, jaw, silhouette or colouring still counts as the same species: never reuse it for another game. COMPARE — Tyrannosaurus; EXPLORE — Stegosaurus; PAIRS — Triceratops; BONES — Brachiosaurus skeleton; DIG — Therizinosaurus; SORT — Pachycephalosaurus (full colour, never silhouette); CARE — Oviraptor; DRAW — Parasaurolophus; MAZE — Ankylosaurus; PUZZLE — Spinosaurus; TEETH — Baryonyx; COLOR — Mosasaurus. SOON has no creature. Reserve a new unused species for each new game.",
          "lineHeight": 1.4,
          "fontFamily": "$ds-font",
          "fontSize": 14,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "b1AFQ",
          "name": "Rule · New game marker",
          "fill": "$ds-ink",
          "textGrowth": "fixed-width",
          "width": 960,
          "content": "NEWNESS · Use a reward-colour 24 px sparkle disc on the top-leading pocket rim, x4 / y−8, keeping the creature clear. No visible NEW or НОВОЕ text. Add New game / Новая игра to the card accessible name; the marker is decorative. The placement is identical in every locale and device.",
          "lineHeight": 1.4,
          "fontFamily": "$ds-font",
          "fontSize": 14,
          "fontWeight": "normal"
        }
      ]
    },
