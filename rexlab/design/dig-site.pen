    {
      "type": "frame",
      "id": "i5sDU",
      "x": 5513,
      "y": 8750,
      "name": "Home · how it scrolls",
      "theme": {
        "mode": "light",
        "device": "phone"
      },
      "clip": true,
      "width": 560,
      "fill": "$ds-sky-bottom",
      "layout": "vertical",
      "gap": 18,
      "padding": 40,
      "children": [
        {
          "type": "text",
          "id": "KieWj",
          "name": "Title",
          "fill": "$ds-ink",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "HOW HOME SCROLLS",
          "fontFamily": "$ds-font",
          "fontSize": 28,
          "fontWeight": "800"
        },
        {
          "type": "text",
          "id": "L89Qum",
          "name": "One scroll · head",
          "fill": "$ds-ink",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "One scroll",
          "fontFamily": "$ds-font",
          "fontSize": 15,
          "fontWeight": "700"
        },
        {
          "type": "text",
          "id": "qxxm2",
          "name": "One scroll · body",
          "fill": "$ds-ink-soft",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "One page, scrolled up and down only, the same on iPad and iPhone. No sideways swiping, no pages, no snapping.",
          "lineHeight": 1.45,
          "fontFamily": "$ds-font",
          "fontSize": 14,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "NmqZN",
          "name": "Scrolling is digging · head",
          "fill": "$ds-ink",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Scrolling is digging",
          "fontFamily": "$ds-font",
          "fontSize": 15,
          "fontWeight": "700"
        },
        {
          "type": "text",
          "id": "xsac3",
          "name": "Scrolling is digging · body",
          "fill": "$ds-ink-soft",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Sky with today's game, then the earth. Each row of games is one earth layer, Sand and Ochre in turn, and bedrock is always last; going down means digging deeper.",
          "lineHeight": 1.45,
          "fontFamily": "$ds-font",
          "fontSize": 14,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "w0Y0C4",
          "name": "iPad 11 and iPad mini · head",
          "fill": "$ds-ink",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Tiles flow",
          "fontFamily": "$ds-font",
          "fontSize": 15,
          "fontWeight": "700"
        },
        {
          "type": "text",
          "id": "TJvg7",
          "name": "iPad 11 and iPad mini · body",
          "fill": "$ds-ink-soft",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "A row holds as many tiles as fit between the margins at their smallest: 150 on iPad and desktop (gap 12), 100 on phones (gap 10). The twelve tiles (eleven games and SOON) are spread evenly over as few rows as that allows, longer rows first, so rows differ by one tile at most and no tile is left alone. Tiles widen up to 200 on iPad and 130 on phones, and each row is centred. Never a fixed count of columns: the board beside this note shows eight widths.",
          "lineHeight": 1.45,
          "fontFamily": "$ds-font",
          "fontSize": 14,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "xu2rl",
          "name": "iPhone · head",
          "fill": "$ds-ink",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "iPhone and iPhone SE",
          "fontFamily": "$ds-font",
          "fontSize": 15,
          "fontWeight": "700"
        },
        {
          "type": "text",
          "id": "t1ZMy",
          "name": "iPhone · body",
          "fill": "$ds-ink-soft",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Four layers of three. The first screen holds today's game and the first layer, and the next layer's pockets peek above the home indicator, so there is visibly more below. The iPhone SE keeps the same page; its first screen ends inside the first layer.",
          "lineHeight": 1.45,
          "fontFamily": "$ds-font",
          "fontSize": 14,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "quGcH",
          "name": "Upright, SE and side · head",
          "fill": "$ds-ink",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "iPad, upright and on its side",
          "fontFamily": "$ds-font",
          "fontSize": 15,
          "fontWeight": "700"
        },
        {
          "type": "text",
          "id": "CKws2",
          "name": "Upright, SE and side · body",
          "fill": "$ds-ink-soft",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "iPad mini and iPad 11 in landscape, and the iPhone on its side, have two layers of six; on the iPad every game fits the first screen and scrolling only uncovers the bedrock with the parent note. The iPad upright has three layers of four under today's game, all on the first screen.",
          "lineHeight": 1.45,
          "fontFamily": "$ds-font",
          "fontSize": 14,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "j4LCS0",
          "name": "Nothing sticks · head",
          "fill": "$ds-ink",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Nothing sticks",
          "fontFamily": "$ds-font",
          "fontSize": 15,
          "fontWeight": "700"
        },
        {
          "type": "text",
          "id": "ONiNm",
          "name": "Nothing sticks · body",
          "fill": "$ds-ink-soft",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "The header scrolls away with the sky. Home has no back button, and the parent controls belong at the top.",
          "lineHeight": 1.45,
          "fontFamily": "$ds-font",
          "fontSize": 14,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "qxJ60",
          "name": "Motion · head",
          "fill": "$ds-ink",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Motion",
          "fontFamily": "$ds-font",
          "fontSize": 15,
          "fontWeight": "700"
        },
        {
          "type": "text",
          "id": "rUnmQ",
          "name": "Motion · body",
          "fill": "$ds-ink-soft",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "The sky moves at half speed (sun or moon and dinosaurs). Tiles rise in row by row the first time they come into view. Reduced motion: no parallax, short fades.",
          "lineHeight": 1.45,
          "fontFamily": "$ds-font",
          "fontSize": 14,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "W99Nw",
          "name": "Edges · head",
          "fill": "$ds-ink",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Edges",
          "fontFamily": "$ds-font",
          "fontSize": 15,
          "fontWeight": "700"
        },
        {
          "type": "text",
          "id": "gIhyX",
          "name": "Edges · body",
          "fill": "$ds-ink-soft",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Pulling past the top shows more sky, past the bottom more bedrock, never a white gap. The status bar and home indicator float over the page.",
          "lineHeight": 1.45,
          "fontFamily": "$ds-font",
          "fontSize": 14,
          "fontWeight": "normal"
        }
      ]
    },
