    {
      "type": "frame",
      "id": "i5sDU",
      "x": 5513,
      "y": 8750,
      "name": "Home · how it scrolls",
      "theme": {
        "mode": "light",
        "device": "phone"
      },
      "clip": true,
      "width": 560,
      "height": 852,
      "fill": "$ds-sky-bottom",
      "layout": "vertical",
      "gap": 18,
      "padding": 40,
      "children": [
        {
          "type": "text",
          "id": "KieWj",
          "name": "Title",
          "fill": "$ds-ink",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "HOW HOME SCROLLS",
          "fontFamily": "$ds-font",
          "fontSize": 28,
          "fontWeight": "800"
        },
        {
          "type": "text",
          "id": "L89Qum",
          "name": "One scroll · head",
          "fill": "$ds-ink",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "One scroll",
          "fontFamily": "$ds-font",
          "fontSize": 15,
          "fontWeight": "700"
        },
        {
          "type": "text",
          "id": "qxxm2",
          "name": "One scroll · body",
          "fill": "$ds-ink-soft",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "One page, scrolled up and down only, the same on iPad and iPhone. No sideways swiping, no pages, no snapping.",
          "lineHeight": 1.45,
          "fontFamily": "$ds-font",
          "fontSize": 14,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "NmqZN",
          "name": "Scrolling is digging · head",
          "fill": "$ds-ink",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Scrolling is digging",
          "fontFamily": "$ds-font",
          "fontSize": 15,
          "fontWeight": "700"
        },
        {
          "type": "text",
          "id": "xsac3",
          "name": "Scrolling is digging · body",
          "fill": "$ds-ink-soft",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Sky with today's game, then sand, ochre and bedrock. Each row of games is one earth layer; going down means digging deeper.",
          "lineHeight": 1.45,
          "fontFamily": "$ds-font",
          "fontSize": 14,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "w0Y0C4",
          "name": "iPad 11 and iPad mini · head",
          "fill": "$ds-ink",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "iPad 11 and iPad mini",
          "fontFamily": "$ds-font",
          "fontSize": 15,
          "fontWeight": "700"
        },
        {
          "type": "text",
          "id": "TJvg7",
          "name": "iPad 11 and iPad mini · body",
          "fill": "$ds-ink-soft",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Every game fits the first screen in landscape. Scrolling only uncovers the bedrock with the parent note: 30 px on iPad 11, 72 px on mini. A third row of games becomes a deeper layer and the page grows.",
          "lineHeight": 1.45,
          "fontFamily": "$ds-font",
          "fontSize": 14,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "xu2rl",
          "name": "iPhone · head",
          "fill": "$ds-ink",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "iPhone",
          "fontFamily": "$ds-font",
          "fontSize": 15,
          "fontWeight": "700"
        },
        {
          "type": "text",
          "id": "t1ZMy",
          "name": "iPhone · body",
          "fill": "$ds-ink-soft",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "The first screen holds today's game and the first layer; the next layer's pockets peek above the home indicator, so there is visibly more below. The whole page is about 1.4 screens.",
          "lineHeight": 1.45,
          "fontFamily": "$ds-font",
          "fontSize": 14,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "j4LCS0",
          "name": "Nothing sticks · head",
          "fill": "$ds-ink",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Nothing sticks",
          "fontFamily": "$ds-font",
          "fontSize": 15,
          "fontWeight": "700"
        },
        {
          "type": "text",
          "id": "ONiNm",
          "name": "Nothing sticks · body",
          "fill": "$ds-ink-soft",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "The header scrolls away with the sky. Home has no back button, and the parent controls belong at the top.",
          "lineHeight": 1.45,
          "fontFamily": "$ds-font",
          "fontSize": 14,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "qxJ60",
          "name": "Motion · head",
          "fill": "$ds-ink",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Motion",
          "fontFamily": "$ds-font",
          "fontSize": 15,
          "fontWeight": "700"
        },
        {
          "type": "text",
          "id": "rUnmQ",
          "name": "Motion · body",
          "fill": "$ds-ink-soft",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "The sky moves at half speed (sun or moon and dinosaurs). Tiles rise in row by row the first time they come into view. Reduced motion: no parallax, short fades.",
          "lineHeight": 1.45,
          "fontFamily": "$ds-font",
          "fontSize": 14,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "W99Nw",
          "name": "Edges · head",
          "fill": "$ds-ink",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Edges",
          "fontFamily": "$ds-font",
          "fontSize": 15,
          "fontWeight": "700"
        },
        {
          "type": "text",
          "id": "gIhyX",
          "name": "Edges · body",
          "fill": "$ds-ink-soft",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Pulling past the top shows more sky, past the bottom more bedrock, never a white gap. The status bar and home indicator float over the page.",
          "lineHeight": 1.45,
          "fontFamily": "$ds-font",
          "fontSize": 14,
          "fontWeight": "normal"
        }
      ]
    },
