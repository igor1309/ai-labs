    {
      "type": "frame",
      "id": "y8u5Id",
      "x": 20209,
      "y": 7760,
      "name": "Home · how a sky is composed",
      "theme": {
        "mode": "light",
        "device": "phone"
      },
      "clip": true,
      "width": 560,
      "fill": "$ds-sky-bottom",
      "layout": "vertical",
      "gap": 18,
      "padding": 40,
      "children": [
        {
          "type": "text",
          "id": "y838f",
          "name": "Title",
          "fill": "$ds-ink",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "HOW A SKY IS COMPOSED",
          "fontFamily": "$ds-font",
          "fontSize": 28,
          "fontWeight": "800"
        },
        {
          "type": "text",
          "id": "pYDPA",
          "name": "One scroll · head",
          "fill": "$ds-ink",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "The art box",
          "fontFamily": "$ds-font",
          "fontSize": 15,
          "fontWeight": "700"
        },
        {
          "type": "text",
          "id": "GNOLv",
          "name": "One scroll · body",
          "fill": "$ds-ink-soft",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Each game's art stands in one box per device, on the ground just above the first layer: right of the name on iPad mini and on a phone on its side, across the width under the name on the upright iPad, between PLAY and the first layer on iPhone. The art is the game's own pictures, already cut out, scaled together to fit the box and centred. What walks stands on the ground with a soft shadow; what flies has none. The sun or moon stays behind it. Anything the art adds around the pictures is built from the design tokens, as the screen is: a card or tray has the panel corner, a basket or pocket the pocket corners, a puzzle piece the tag corner; a raised thing casts the ground shadow; paints are the action, reward, good and paint-blue colours; written words use the hand font. So the art turns dark with the screen.",
          "lineHeight": 1.45,
          "fontFamily": "$ds-font",
          "fontSize": 14,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "h0i3r",
          "name": "Scrolling is digging · head",
          "fill": "$ds-ink",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "The name",
          "fontFamily": "$ds-font",
          "fontSize": 15,
          "fontWeight": "700"
        },
        {
          "type": "text",
          "id": "H0mXFi",
          "name": "Scrolling is digging · body",
          "fill": "$ds-ink-soft",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "The game's full name, as the app calls it, in capitals beside its symbol. It wraps in the room the art leaves, never inside a word. When the longest word does not fit at display size (64 on iPad, 50 on phones), the whole name steps down until it does. On a phone a two-line name pushes the art box down and the art shrinks with it.",
          "lineHeight": 1.45,
          "fontFamily": "$ds-font",
          "fontSize": 14,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "SOQ7g",
          "name": "iPad 11 and iPad mini · head",
          "fill": "$ds-ink",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Progress",
          "fontFamily": "$ds-font",
          "fontSize": 15,
          "fontWeight": "700"
        },
        {
          "type": "text",
          "id": "x7Sup",
          "name": "iPad 11 and iPad mini · body",
          "fill": "$ds-ink-soft",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Beside PLAY, in the game's own form: a best (trophy 8 / 10), stars (120), what is collected (5 / 16 jaws, 7 / 52 dug up), or nothing for a game that keeps no score. A first visit shows none; EXPLORE's 52 creatures are a count, not progress, and always show.",
          "lineHeight": 1.45,
          "fontFamily": "$ds-font",
          "fontSize": 14,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "LB90n",
          "name": "iPhone · head",
          "fill": "$ds-ink",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Tiles",
          "fontFamily": "$ds-font",
          "fontSize": 15,
          "fontWeight": "700"
        },
        {
          "type": "text",
          "id": "oey9b",
          "name": "iPhone · body",
          "fill": "$ds-ink-soft",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Today's game leaves its tile. The others keep their order and move up, COMPARE first, so no game is on the page twice.",
          "lineHeight": 1.45,
          "fontFamily": "$ds-font",
          "fontSize": 14,
          "fontWeight": "normal"
        }
      ]
    },
