    {
      "type": "frame",
      "id": "YtHMC",
      "x": 11946,
      "y": 7847,
      "name": "Home · how the tiles flow · every window width",
      "theme": {
        "mode": "light"
      },
      "fill": "$ds-sky-bottom",
      "layout": "vertical",
      "gap": 18,
      "padding": 32,
      "children": [
        {
          "type": "text",
          "id": "BsXsR",
          "name": "Title",
          "fill": "$ds-ink",
          "content": "Tiles flow: as many as fit, spread evenly, one earth layer per row",
          "fontFamily": "$ds-font",
          "fontSize": 20,
          "fontWeight": "800"
        },
        {
          "type": "text",
          "id": "WJuQ7",
          "name": "Rule",
          "fill": "$ds-ink",
          "textGrowth": "fixed-width",
          "width": 960,
          "content": "Across = how many tiles of the smallest size fit between the margins (150 on iPad and desktop, 100 on phones, with their gaps). Rows = the tiles ÷ across, rounded up. The tiles are then spread evenly over those rows, longer rows first, so rows differ by one tile at most and no tile sits alone. Tiles widen to share a row, up to 200 on iPad and 130 on phones, and the row centres. Twelve tiles: eleven games and SOON; today's game is in the sky.",
          "lineHeight": 1.4,
          "fontFamily": "$ds-font",
          "fontSize": 14,
          "fontWeight": "normal"
        },
