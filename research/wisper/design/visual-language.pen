            {
              "type": "text",
              "id": "qVvh3",
              "name": "Idea",
              "fill": "#444444",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "One page, label column on the left. Data folder; the final-pass engine (required, so there is no empty choice); audio cleanup, stated rather than set (7 days, pin to keep); the explain hotkey. Chunk size appears only in debug builds, under a DEBUG mark; release builds use 4 s.",
              "lineHeight": 1.5,
              "fontFamily": "Inter",
              "fontSize": 15,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "whzA6",
              "name": "Open",
              "fill": "#B4540A",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Proposed, not decided: whether changing the data folder moves existing calls; the chunk-size steps offered in debug (shown 2–8 s); audio cleanup as fixed text rather than a setting.",
              "lineHeight": 1.5,
              "fontFamily": "Inter",
              "fontSize": 13,
              "fontWeight": "normal"
            }
          ]
        },
