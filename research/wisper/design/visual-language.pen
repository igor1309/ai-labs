        {
          "type": "text",
          "id": "pcflK",
          "name": "Scope",
          "fill": "#444444",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Each proposal is the floating panel from mvp.md over a call window, in light and dark (both mandatory; the panel follows the system theme). Two speakers, settled vs pending text, a selected term with its ≤40-word Russian explanation (needs.md). Same sample call and the same light and dark desktops in all six panels, so only the visual language differs. Research: ../gallery/stt-apps.pen.",
          "lineHeight": 1.5,
          "fontFamily": "Inter",
          "fontSize": 15,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "bKRXl",
          "name": "Open questions",
          "fill": "#B5562F",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Open for the owner: which direction (or which parts to combine) · should the explanation stay in the panel or go only to bb · speaker labels: words, colours or arrows.",
          "lineHeight": 1.5,
          "fontFamily": "Inter",
          "fontSize": 14,
          "fontWeight": "normal"
        }
      ]
    },
